int function remove(char * _file_path); 
int function rename(char unsigned * _old_name , char unsigned * _new_name);
FILE *function tmpfile();
int function fgetc(FILE *_stream);
char *function fgets(char *_str, int _n, FILE *_stream);
int function fputc(char _c, FILE *_stream);
int function getchar();
char *function gets(char *_str);
