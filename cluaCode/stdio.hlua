#ifndef STDIO_CLUA
#define STDIO_CLUA

#define FILE_READ : "r"
#define FILE_WRITE : "w"
#define FILE_APPEND : "a"

#define FILE_READ_BINARY : "rb"
#define FILE_WRITE_BINARY : "wb"
#define FILE_APPEND_BINARY : "ab"

#define FILE_READ_WRITE : "r+"
#define FILE_READ_WRITE_OVERWRITE : "w+"
#define FILE_READ_APPEND : "a+"

#define FILE_READ_WRITE_BINARY : "rb+"
#define FILE_READ_WRITE_OVERWRITE_BINARY : "wb+"
#define FILE_READ_APPEND_BINARY : "ab+"

intern

struct FILE{ -- gcc
	char *_ptr;
    int _cnt;
    char *_base;
    int _flag;
    int _file;
    int _charbuf;
    int _bufsiz;
    char *_tmpfname;
};

FILE *stdout;
FILE *stdin;
FILE *stderr;

FILE * function fopen(char* _file_path, char* _mode);

int function fputs(FILE *_stream, char *_line);
int function fputc(FILE *_stream, char _c);
int function fputw(FILE *_stream, int long long _c);
int function fwrite(void *_ptr, size_t _size, size_t _count, FILE *_stream);

--int function fputs(FILE *_stream, char *_line);
--char function fgetc(FILE *_stream);
--int function fputw(FILE *_stream, int long long _c);
--int function fputw(FILE *_stream, int long long _c);
--int function fwrite(const void *_ptr, size_t _size, size_t _count, FILE *_stream);
--FILE * function fopen(char* file_path, char* mode);

int function printInt(int _v);
int function printIntLong(int long _v);
int function printIntLongLong(int long long _v);
int function printIntShort(int short _v);
int function printChar(char _v);
int function printFloat(float _v);
int function printDouble(double _v);
int function printDoubleLong(double long _v);
int function printString(char *_str);
int function printPointer(void *_pointer);
inend

extern
#include <stdio.h>

#define printInt(a)         printf("%d", (a))
#define printIntLong(a)     printf("%ld", (a))
#define printIntLongLong(a) printf("%lld", (a))
#define printIntShort(a)    printf("%hd", (a))
#define printChar(a)        printf("%c", (a))
#define printFloat(a)       printf("%f", (a))
#define printDouble(a)      printf("%f", (a))
#define printDoubleLong(a)  printf("%Lf", (a))
#define printString(a)      printf("%s", (a))
#define printPointer(a)     printf("%p", (void*)(a))
#define printCustom(a, b)   printf(a, *a)

exend

#endif