#require <test/stdio.hlua>

struct vec2;

struct vec2 {
	float x;
	float y;
};

struct square{
	vec2* position;
	vec2* size;
};

void function makeSquare(vec2 const *position, vec2 const *size, square *dest)
	dest->position = position;
	dest->size = size;
	return void;
end

int function main(int argc, char ** argv)
	for(int i = 0; i < argc; i = i + 1) do
		--printInt(i);
		--printChar(':':char:);
		--printChar(' ':char:);
		--printString(argv[i]);
		--printChar('\n':char:);
	end

	argv[0] = argv[0];

	vec2 pos = {
		.x = 150.0,
		.y = 200.0
	};

	vec2 size = {
		.x = 100.0,
		.y = 50.0
	};

	square my_square;
	makeSquare(&pos, &size, &my_square);

	float sum = 
	my_square.position->x +
	my_square.position->y +
	my_square.size->x +
	my_square.size->y;

	return sum:int:;
end