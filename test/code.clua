float function areaOfTriangle(float [3][3] triangle)
	float neg = -(triangle[0][0] * triangle[1][1] * triangle[2][2]);
	float pos = (triangle[0][2] * triangle[1][1] * triangle[2][0]);
	return (neg + pos) / 2.0;
end

