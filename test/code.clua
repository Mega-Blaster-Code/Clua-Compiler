void function cluaPrintc(char _c);

void function cluaPrintf(float _f);

void function cluaPrintfd(double _fd);
void function cluaPrintfdl(double long _fdl);

void function cluaPrintds(int short _is);
void function cluaPrintd(int _d);
void function cluaPrintdl(int long _dl);
void function cluaPrintdll(int long long _dll);

char function cluaScan();

int function add3(int [3] triangle)
	triangle[0] = 9;
	return 9;
end

int function add3x3(int [[3] triangle)
	triangle[0][0] = 9;
	return 9;
end

void function testvoid()
	return void;
end

int function main()
	int x = 10;

	do

		x = 10;
		x = 1;

	end

	float y = x:float: * 2.5;

	int [3] tri = [0, 9, 7];

	tri[0] = x;
	tri[0] = y:int:;
	tri[0] = 1;
	
	add3(tri);

	float result;

	for(int long long i = 0; i < 10; i = i + 1) do
		testvoid();
		int y1 = 10;
		int x1 = 2;
		int z1 = -2;
		int [3] points = [x1, y1, z1];
		result = add3(points):float: + 7.0 + i:float:;
		if(result > 10.0) then
			break;
		end
	end

	return result:int:;
end

-- ======================================


int global_value = 100;
int *global_ptr = &global_value;

int function increment(int *v)
	*v = *v + 1;
	return *v;
end

int function add(int *a, int *b)
	return *a + *b;
end

int function swap(int *a, int *b)
	int tmp = *a;
	*a = *b;
	*b = tmp;
	return 0;
end

int function set_value(int *p, int value)
	*p = value;
	return *p;
end

int * function select_pointer(int *a, int *b, int cond)
	if (cond) then
		return a;
	else
		return b;
	end
end

int function sum_array(int *arr, int size)
	int i = 0;
	int total = 0;

	while (i < size) do
		total = total + arr[i];
		i = i + 1;
	end

	return total;
end

int function increment_array(int *arr, int size)
	int i = 0;

	while (i < size) do
		arr[i] = arr[i] + 1;
		i = i + 1;
	end

	return 0;
end

int function pointer_arithmetic(int *arr)
	int *p = arr;

	int a = *p;
	int b = *(p + 1);
	int c = *(p + 2);

	return a + b + c;
end

int function double_pointer_test()
	int x = 10;

	int *p = &x;
	int **pp = &p;

	**pp = **pp + 5;

	return x;
end

int function pointer_compare(int *a, int *b)
	if (a == b) then
		return 1;
	end
	return 0;
end

int function pointer_chain()
	int a = 1;
	int b = 2;
	int c = 3;

	int *p1 = &a;
	int *p2 = &b;
	int *p3 = &c;

	int **pp = &p1;

	*pp = p2;
	*p2 = *p2 + 10;

	*pp = p3;
	*p3 = *p3 + 20;

	return a + b + c;
end

int function pointer_array_test()
	int [5] arr = [1,2,3,4,5];

	int *p = arr;

	int a = *p;
	int b = *(p + 1);
	int c = *(p + 2);

	p = p + 3;

	int d = *p;

	return a + b + c + d;
end

int function pointer_to_pointer_array()
	int a = 10;
	int b = 20;
	int c = 30;

	int * [3] ptrs = [&a, &b, &c];

	int **pp = ptrs;

	int r = **pp;
	pp = pp + 1;
	r = r + **pp;
	pp = pp + 1;
	r = r + **pp;

	return r;
end

int function pointer_write_chain()
	int x = 5;

	int *p = &x;
	int **pp = &p;

	*p = 10;
	**pp = **pp + 5;

	return x;
end

int function pointer_return_global()
	int *p = &global_value;
	return *p;
end

int function pointer_parameter_test()
	int a = 10;
	int b = 20;

	swap(&a, &b);

	return a + b;
end

int function pointer_selection_test()
	int a = 5;
	int b = 9;

	int *p = select_pointer(&a, &b, 1);
	*p = *p + 10;

	return a + b;
end

int function pointer_walk()
	int [4] arr = [3,6,9,12];

	int *p = arr;
	int i = 0;
	int total = 0;

	while (i < 4) do
		total = total + *p;
		p = p + 1;
		i = i + 1;
	end

	return total;
end

int function nested_pointer_modification()
	int a = 7;
	int *p = &a;
	int **pp = &p;

	**pp = 42;

	return a;
end

int function pointer_aliasing()
	int x = 1;

	int *a = &x;
	int *b = a;

	*a = 5;
	*b = *b + 10;

	return x;
end

int function main()

	int a = 10;
	int b = 20;

	int *pa = &a;
	int *pb = &b;

	int result1 = add(pa, pb);

	increment(&a);

	swap(&a, &b);

	int [5] arr = [1,2,3,4,5];

	int total = sum_array(arr, 5);

	increment_array(arr, 5);

	int result2 = pointer_arithmetic(arr);

	int result3 = double_pointer_test();

	int result4 = pointer_chain();

	int result5 = pointer_array_test();

	int result6 = pointer_to_pointer_array();

	int result7 = pointer_write_chain();

	int result8 = pointer_return_global();

	int result9 = pointer_parameter_test();

	int result10 = pointer_selection_test();

	int result11 = pointer_walk();

	int result12 = nested_pointer_modification();

	int result13 = pointer_aliasing();

	int final_result =
		result1 +
		result2 +
		result3 +
		result4 +
		result5 +
		result6 +
		result7 +
		result8 +
		result9 +
		result10 +
		result11 +
		result12 +
		result13 +
		total +
		a +
		b;

	return final_result;

end

int global_value = 50;
int *global_ptr = &global_value;

int function add(int *a, int *b)
	return *a + *b;
end

int function swap(int *a, int *b)
	int tmp = *a;
	*a = *b;
	*b = tmp;
	return 0;
end

int function max_ptr(int *a, int *b)
	if (*a > *b) then
		return *a;
	elseif (*b > *a) then
		return *b;
	else
		return *a;
	end
	return 0;
end

int function increment_all(int *arr, int size)
	int i = 0;

	while (i < size) do
		arr[i] = arr[i] + 1;
		i = i + 1;
	end

	return 0;
end

int function sum_array(int *arr, int size)
	int total = 0;

	for (int i = 0; i < size; i = i + 1) do
		total = total + arr[i];
	end

	return total;
end

int function pointer_walk(int *arr, int size)
	int *p = arr;
	int total = 0;

	for (int i = 0; i < size; i = i + 1) do
		total = total + *p;
		p = p + 1;
	end

	return total;
end

int function double_pointer_test()
	int x = 5;

	int *p = &x;
	int **pp = &p;

	**pp = **pp + 10;

	return x;
end

int function pointer_chain()
	int a = 1;
	int b = 2;
	int c = 3;

	int *p1 = &a;
	int *p2 = &b;
	int *p3 = &c;

	int **pp = &p1;

	*pp = p2;
	*p2 = *p2 + 10;

	*pp = p3;
	*p3 = *p3 + 20;

	return a + b + c;
end

int function pointer_array_test()
	int [4] arr = [1,2,3,4];

	int *p = arr;

	int a = *p;
	int b = *(p + 1);
	int c = *(p + 2);

	return a + b + c;
end

int function pointer_selection()
	int a = 5;
	int b = 8;

	int *p = &a;

	if (a < b) then
		p = &b;
	end

	*p = *p + 10;

	return a + b;
end

int function alias_test()
	int x = 2;

	int *a = &x;
	int *b = a;

	*a = 10;
	*b = *b + 5;

	return x;
end

int function nested_pointer_mod()
	int x = 3;

	int *p = &x;
	int **pp = &p;

	**pp = 20;

	return x;
end

int function main()

	int a = 10;
	int b = 20;

	int *pa = &a;
	int *pb = &b;

	int r1 = add(pa, pb);

	swap(&a, &b);

	int [5] arr = [1,2,3,4,5];

	increment_all(arr, 5);

	int r2 = sum_array(arr, 5);

	int r3 = pointer_walk(arr, 5);

	int r4 = double_pointer_test();

	int r5 = pointer_chain();

	int r6 = pointer_array_test();

	int r7 = pointer_selection();

	int r8 = alias_test();

	int r9 = nested_pointer_mod();

	int final =
		r1 +
		r2 +
		r3 +
		r4 +
		r5 +
		r6 +
		r7 +
		r8 +
		r9 +
		a +
		b;

	return final;

end

